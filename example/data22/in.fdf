SpinPolarized    F
   
DM.MixingWeight      0.4   
DM.NumberPulay       9
DM.Tolerance         1.d-4
   
   
###################   RunInfo  ###################
MD.TypeOfRun     CG  # CG/FIRE optimize Verlet MD
MD.VariableCell  true
MD.TargetStress  0.000000 GPa
MD.Steps         200
MD.MaxCGDispl    0.1 Ang 
MD.MaxForceTol   0.03 eV/Ang 
MD.UseSaveXV     F 
MD.UseSaveZM     false 
   
   
################### FUNCTIONAL ###################
XC.functional    GGA    # Exchange-correlation functional type
XC.Authors       PBE    # Particular parametrization of xc func
   
   
MeshCutoff       200. Ry # Equivalent planewave cutoff for the grid 
KgridCutoff      6.636475 Ang
   
   
WriteCoorInitial T
WriteCoorXmol    T
WriteMDhistory   T
WriteMullikenPop 1
WriteForces      T
   
